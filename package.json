{
  "name": "inbox-ops",
  "version": "0.1.0",
  "description": "AI-assisted support inbox for an online store: suggests category, summary and missing data, with human review.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "triage": "tsx --env-file-if-exists=.env src/main.ts",
    "eval": "tsx --env-file-if-exists=.env src/evaluation/run-eval.ts",
    "serve": "tsx --env-file-if-exists=.env src/server.ts",
    "build:web": "npm --prefix web run build",
    "demo": "npm run build:web && npm run serve",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@ai-sdk/groq": "^4.0.60",
    "@hono/node-server": "^2.1.5",
    "ai": "^7.0.139",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  }
}
